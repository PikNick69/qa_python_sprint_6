import allure
import pytest
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.common.exceptions import TimeoutException, ElementClickInterceptedException
from pages.home_page import HomePage
from pages.order_page import OrderPage
from data.test_data import ORDER_DATA
import time


@allure.epic("Тестирование сервиса 'Яндекс.Самокат'")
@allure.feature("Диагностика проблемы с дропдауном")
class TestDropdownDiagnostic:

    @pytest.mark.diagnostic
    @allure.title("Диагностика дропдауна периода аренды")
    @allure.description("Подробная проверка всех аспектов работы дропдауна")
    def test_dropdown_diagnostic(self, driver):
        """Подробный диагностический тест для выявления проблемы с дропдауном"""
        
        home_page = HomePage(driver)
        order_page = OrderPage(driver)
        
        # Шаг 1: Добираемся до страницы с дропдауном
        with allure.step("Шаг 1: Переход к форме заказа"):
            home_page.click_top_order_button()
            WebDriverWait(driver, 5).until(EC.url_contains("order"))
            print("✅ Перешли на страницу заказа")
        
        # Шаг 2: Заполняем первую форму
        with allure.step("Шаг 2: Заполнение первой формы"):
            test_data = ORDER_DATA[0]
            order_page.fill_first_form(
                test_data["name"],
                test_data["surname"],
                test_data["address"],
                test_data["metro"],
                test_data["phone"]
            )
            print("✅ Первая форма заполнена")
        
        # Шаг 3: Переходим ко второй форме
        with allure.step("Шаг 3: Переход ко второй форме"):
            order_page.click_next()
            time.sleep(2)  # Даем время для загрузки
            print("✅ Перешли ко второй форме")
        
        # Шаг 4: ДЕТАЛЬНАЯ ПРОВЕРКА ДРОПДАУНА
        with allure.step("Шаг 4: Детальная проверка дропдауна"):
            
            # 4.1 Проверяем, есть ли вообще элемент на странице
            try:
                dropdown = driver.find_element(*order_page.rental_period_dropdown)
                print("✅ Элемент дропдауна найден в DOM")
            except:
                print("❌ Элемент дропдауна НЕ найден в DOM")
                allure.attach(driver.get_screenshot_as_png(), 
                             name="dropdown_not_found", 
                             attachment_type=allure.attachment_type.PNG)
                assert False, "Дропдаун не найден в DOM"
            
            # 4.2 Проверяем видимость
            is_visible = dropdown.is_displayed()
            print(f"Видимость элемента: {is_visible}")
            
            # 4.3 Проверяем, активен ли элемент
            is_enabled = dropdown.is_enabled()
            print(f"Элемент активен: {is_enabled}")
            
            # 4.4 Получаем размер и позицию
            location = dropdown.location
            size = dropdown.size
            print(f"Позиция: x={location['x']}, y={location['y']}")
            print(f"Размер: width={size['width']}, height={size['height']}")
            
            # 4.5 Получаем CSS свойства
            z_index = dropdown.value_of_css_property("z-index")
            position = dropdown.value_of_css_property("position")
            print(f"z-index: {z_index}")
            print(f"position: {position}")
            
            # 4.6 Проверяем, что находится под дропдауном (что его перекрывает)
            center_x = location['x'] + size['width'] / 2
            center_y = location['y'] + size['height'] / 2
            
            element_at_point = driver.execute_script("""
                var x = arguments[0];
                var y = arguments[1];
                return document.elementFromPoint(x, y).tagName + '.' + 
                       (document.elementFromPoint(x, y).className || 'no-class');
            """, center_x, center_y)
            
            print(f"Элемент под центром дропдауна: {element_at_point}")
            
            # 4.7 Проверяем, есть ли модальные окна
            modals = driver.find_elements(By.XPATH, 
                "//div[contains(@class, 'modal') or contains(@class, 'popup') or contains(@style, 'position: fixed')]")
            print(f"Найдено модальных окон/попапов: {len(modals)}")
            
            for i, modal in enumerate(modals):
                if modal.is_displayed():
                    print(f"  Попап #{i+1}: класс={modal.get_attribute('class')}, видим=да")
                else:
                    print(f"  Попап #{i+1}: класс={modal.get_attribute('class')}, видим=нет")
            
            # Делаем скриншот всей страницы
            allure.attach(driver.get_screenshot_as_png(), 
                         name="page_state_before_click", 
                         attachment_type=allure.attachment_type.PNG)
            
            print("\n" + "="*50)
            print("РЕЗУЛЬТАТЫ ДИАГНОСТИКИ:")
            print("="*50)
        
        # Шаг 5: Пробуем разные способы клика
        with allure.step("Шаг 5: Тестирование разных способов клика"):
            
            # Способ 1: Обычный клик
            try:
                with allure.step("Попытка 1: Обычный клик"):
                    dropdown.click()
                    print("✅ Обычный клик сработал!")
                    result1 = "УСПЕХ"
            except Exception as e:
                print(f"❌ Обычный клик не сработал: {type(e).__name__}")
                result1 = f"ОШИБКА: {type(e).__name__}"
            
            # Способ 2: Клик через JavaScript
            try:
                with allure.step("Попытка 2: JavaScript клик"):
                    driver.execute_script("arguments[0].click();", dropdown)
                    print("✅ JavaScript клик сработал!")
                    result2 = "УСПЕХ"
            except Exception as e:
                print(f"❌ JavaScript клик не сработал: {type(e).__name__}")
                result2 = f"ОШИБКА: {type(e).__name__}"
            
            # Способ 3: Клик после скролла
            try:
                with allure.step("Попытка 3: Скролл + клик"):
                    driver.execute_script("arguments[0].scrollIntoView(true);", dropdown)
                    time.sleep(1)
                    dropdown.click()
                    print("✅ Скролл + клик сработал!")
                    result3 = "УСПЕХ"
            except Exception as e:
                print(f"❌ Скролл + клик не сработал: {type(e).__name__}")
                result3 = f"ОШИБКА: {type(e).__name__}"
            
            # Способ 4: ActionChains
            try:
                with allure.step("Попытка 4: ActionChains"):
                    from selenium.webdriver.common.action_chains import ActionChains
                    actions = ActionChains(driver)
                    actions.move_to_element(dropdown).click().perform()
                    print("✅ ActionChains клик сработал!")
                    result4 = "УСПЕХ"
            except Exception as e:
                print(f"❌ ActionChains клик не сработал: {type(e).__name__}")
                result4 = f"ОШИБКА: {type(e).__name__}"
        
        # Шаг 6: Если дропдаун открылся, проверим его содержимое
        with allure.step("Шаг 6: Проверка открытия дропдауна"):
            time.sleep(2)
            
            # Ищем меню дропдауна
            try:
                menu = driver.find_element(By.CLASS_NAME, "Dropdown-menu")
                if menu.is_displayed():
                    print("✅ Дропдаун успешно открылся!")
                    options = menu.find_elements(By.CLASS_NAME, "Dropdown-option")
                    print(f"   Найдено опций: {len(options)}")
                    for option in options:
                        print(f"   - {option.text}")
                    dropdown_opened = True
                else:
                    print("❌ Дропдаун не открылся (меню не видимо)")
                    dropdown_opened = False
            except:
                print("❌ Дропдаун не открылся (меню не найдено)")
                dropdown_opened = False
        
        # Итоговый отчет
        print("\n" + "="*50)
        print("ИТОГОВЫЙ ДИАГНОСТИЧЕСКИЙ ОТЧЕТ")
        print("="*50)
        print(f"1. Элемент в DOM: ДА")
        print(f"2. Видимость: {is_visible}")
        print(f"3. Активен: {is_enabled}")
        print(f"4. Перекрывающий элемент: {element_at_point if element_at_point != dropdown.tag_name else 'НЕТ'}")
        print(f"5. Модальные окна: {'ЕСТЬ' if modals else 'НЕТ'}")
        print(f"6. Результаты кликов:")
        print(f"   - Обычный клик: {result1}")
        print(f"   - JavaScript клик: {result2}")
        print(f"   - Скролл+клик: {result3}")
        print(f"   - ActionChains: {result4}")
        print(f"7. Дропдаун открылся: {'ДА' if dropdown_opened else 'НЕТ'}")
        print("="*50)
        
        # Сохраняем результаты в Allure
        allure.attach(
            str({
                "visible": is_visible,
                "enabled": is_enabled,
                "location": location,
                "size": size,
                "element_under": element_at_point,
                "modals_count": len(modals),
                "click_results": {
                    "regular": result1,
                    "javascript": result2,
                    "scroll": result3,
                    "actions": result4
                },
                "dropdown_opened": dropdown_opened
            }),
            name="diagnostic_results",
            attachment_type=allure.attachment_type.JSON
        )
        
        # Делаем финальный скриншот
        allure.attach(driver.get_screenshot_as_png(), 
                     name="final_state", 
                     attachment_type=allure.attachment_type.PNG)
        
        # Тест не падает, а просто собирает информацию
        # Но если дропдаун не открылся ни одним способом, помечаем как вероятный баг
        if not dropdown_opened:
            pytest.xfail("Дропдаун не открылся ни одним способом - вероятно, баг в приложении")